# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Neon PostgreSQL ─────────────────────────────────────────────────────────
# Get from: https://neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Set to your Vercel domain in production (e.g. https://mdubusimaths.vercel.app)
AUTH_URL=http://localhost:3000

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: https://yourdomain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Cal.com ─────────────────────────────────────────────────────────────────
# Your Cal.com username (e.g. ps-ndlovu)
CAL_USERNAME=ps-ndlovu
# Public username for the Cal.com embed in the booking wizard (must match CAL_USERNAME)
NEXT_PUBLIC_CAL_USERNAME=ps-ndlovu
# Slugs of your Cal.com event types (set after creating them in Cal.com dashboard)
CAL_EVENT_TYPE_ONCE_OFF=once-off-60min
CAL_EVENT_TYPE_MONTHLY=monthly-60min
CAL_EVENT_TYPE_GROUP=group-120min
# Set after first deploy: Cal.com → Settings → Developer → Webhooks → secret
CAL_WEBHOOK_SECRET=

# ─── Resend (email) ──────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@mdubusimaths.com
RESEND_REPLY_TO=support@mdubusimaths.com

# ─── Tutor account (seeded on first deploy) ──────────────────────────────────
TUTOR_EMAIL=ps@mdubusimaths.com
# Strong password — change via dashboard after first login
TUTOR_INITIAL_PASSWORD=

# ─── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
